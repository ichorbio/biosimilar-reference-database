    "@type": "Organization",
    "name": "ichorbio",
    "url": "https://ichor.bio/"
  },
  "datePublished": "2026-10-05",
  "dateModified": "2026-10-05",
  "keywords": [
    "biosimilar",
    "antibody developability",
    "biophysical data",
    "molecular weight",
    "isoelectric point",
    "Tm",
    "SEC-HPLC",
    "HIC",
    "AC-SINS",
    "PSR",
    "reference dataset"
  ],
  "measurementTechnique": [
    "Theoretical calculation from sequence",
    "Differential scanning fluorimetry (DSF)",
    "SEC-HPLC",
    "HIC-HPLC",
    "AC-SINS",
    "PSR"
  ],
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "mw_kda",
      "description": "Molecular weight",
      "unitText": "kDa"
    },
    {
      "@type": "PropertyValue",
      "name": "theoretical_pi",
      "description": "Isoelectric point (theoretical)",
      "unitText": "pH units"
    }
  ],
