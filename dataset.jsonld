{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "ichorbio Biosimilar Reference Database",
  "description": "Open, citable developability and biophysical data for ichorbio's research-grade biosimilars: identity, sequences, molecular weight and isoelectric point, with ichorbio-measured assay data (Tm, SEC, HIC, AC-SINS, PSR) added over time, plus a separate published-reference developability table (Jain et al. 2017) and Thera-SAbDab cross-reference links.",
  "url": "https://ichor.bio/biosimilar-database/",
  "version": "0.1.5",
  "identifier": "https://doi.org/10.5281/zenodo.23350140",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "isAccessibleForFree": true,
  "creator": {
    "@type": "Organization",
    "name": "ichorbio",
    "url": "https://ichor.bio/"
  },
  "datePublished": "2026-10-05",
  "dateModified": "2026-11-13",
  "keywords": [
    "biosimilar",
    "antibody developability",
    "biophysical data",
    "molecular weight",
    "isoelectric point",
    "Tm",
    "SEC-HPLC",
    "HIC",
    "AC-SINS",
    "PSR",
    "reference dataset"
  ],
  "measurementTechnique": [
    "Theoretical calculation from sequence",
    "Differential scanning fluorimetry (DSF)",
    "SEC-HPLC",
    "HIC-HPLC",
    "AC-SINS",
    "PSR"
  ],
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "mw_kda",
      "description": "Molecular weight",
      "unitText": "kDa"
    },
    {
      "@type": "PropertyValue",
      "name": "theoretical_pi",
      "description": "Isoelectric point (theoretical)",
      "unitText": "pH units"
    }
  ],
  "distribution": [
    {
