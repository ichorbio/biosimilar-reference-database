{
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "ichorbio Biosimilar Reference Database",
  "description": "Open, citable developability and biophysical data for ichorbio's research-grade biosimilars: identity, sequences, molecular weight and isoelectric point, with measured assay data (Tm, SEC, HIC, AC-SINS, PSR) added over time.",
  "url": "https://ichor.bio/biosimilar-database/",
  "version": "0.1.3",
  "identifier": "https://doi.org/10.5281/zenodo.XXXXXXX",
